# Run python scripts/bootstrap_compose.py to generate .env and data/client.env.
# Do not copy this template over existing credentials. Recreate affected services after changes.
# Compose publishes only localhost HTTP; PostgreSQL stays on its private network.
POSTGRES_PASSWORD=
RAGS_DB_PASSWORD=
AGENT_DB_PASSWORD=

RAGS_EXTRAS=postgres,pdf,mcp,vision
AGENT_EXTRAS=postgres,mcp

# Process mode; bootstrap creates separate requester and approver credentials.
AGENT_ENV=production

# Generated requester token for client examples; production uses AGENT_KEYS_JSON.
AGENT_API_KEY=

# Generated approver token for client examples; never reuse requester identity.
AGENT_APPROVER_API_KEY=

# Requester-token-to-tenant map.
AGENT_KEYS_JSON='{}'

# Disjoint approver-token-to-tenant map.
AGENT_APPROVER_KEYS_JSON='{}'

# PostgreSQL DSN generated for non-superuser agent_app.
AGENT_DATABASE_URL=

# Per-process pool cap (0 disables reuse), checkout timeout and waiting requests.
AGENT_PG_POOL_SIZE=4
AGENT_PG_POOL_TIMEOUT=5
AGENT_PG_POOL_MAX_WAITING=32

# Hosted Inkling preset credential; choose direct value or mounted file, never both.
TINKER_API_KEY=
TINKER_API_KEY_FILE=

# Explicit SQLite development compatibility; Compose requires PostgreSQL DSN.
AGENT_DB_PATH=/app/data/agentic.db

# JSON boolean overrides shared by API and worker.
AGENT_FEATURES_FILE=/app/config/agent.features.json

# Per-key JSON overrides take precedence over the file.
AGENT_FEATURES_JSON='{}'

# Fixed knowledge-service URL, shared by API and worker.
AGENT_RAG_URL=http://rags:8000

# Tenant-to-RAG-token map; reverse direction of RAGS_KEYS_JSON.
AGENT_RAG_KEYS_JSON='{}'

# Legacy development fallback only.
AGENT_RAG_API_KEY=

# Whole RAG HTTP exchange, finite 1..360 seconds.
AGENT_RAG_TIMEOUT_SECONDS=180

# calibrated_required also needs a nonempty profile allowlist.
AGENT_RAG_ADMISSION_POLICY=compatibility

# Allowed reviewed profile IDs, snapshotted with new runs.
AGENT_RAG_ADMISSION_PROFILE_IDS_JSON='[]'

# offline, openai, anthropic, inkling. No paid provider is enabled by default.
AGENT_MODEL_PROVIDER=offline

# Optional 1..8 explicit routes with purposes and operator-supplied token prices.
# Local host-native example: examples/inkling-local.routes.json (explicit auth_mode none).
# Authenticated local examples require their explicit api_key_env in both API and worker.
AGENT_MODEL_ROUTES_JSON=

# Operator maxima for tools, namespaces, steps, rounds and budgets.
AGENT_TENANT_POLICIES_JSON='{}'

# Active steps per worker, 1..16.
AGENT_MAX_PARALLEL=4

# Active runs per tenant.
AGENT_MAX_QUEUED_RUNS=100

# Durable claim lease.
AGENT_LEASE_SECONDS=180

# Positive and below one third of the lease.
AGENT_HEARTBEAT_SECONDS=30

# Persisted step deadline.
AGENT_STEP_TIMEOUT_SECONDS=300

# Includes expired leases.
AGENT_MAX_ATTEMPTS=3

# Per-run model token budget.
AGENT_MAX_MODEL_TOKENS=12000

# Requested output cap per model call.
AGENT_MAX_MODEL_OUTPUT_TOKENS=1000

# Whole model call, including streamed body and fallback routes (0.1..360 seconds).
AGENT_MODEL_TIMEOUT_SECONDS=90

# Per tenant/subject fixed-minute request bound.
AGENT_RATE_PER_MINUTE=600

# Local shared-volume limiter if Redis is not selected.
AGENT_RATE_DB_PATH=/app/data/limits.db

# Optional real Redis; requires storage extra.
AGENT_REDIS_URL=

# local or s3; S3 requires storage extra and bucket.
AGENT_ARTIFACT_BACKEND=local

# Persistent local artifact directory.
AGENT_ARTIFACT_DIR=/app/data/artifacts

# S3 bucket, used only when s3 is selected.
AGENT_S3_BUCKET=

# Optional S3-compatible endpoint; production requires HTTPS.
AGENT_S3_ENDPOINT=

# Optional explicit object-store identity; SDK identity chain is also supported.
AWS_ACCESS_KEY_ID=

# Object-store secret; never commit real values.
AWS_SECRET_ACCESS_KEY=

# Optional temporary-credential session token.
AWS_SESSION_TOKEN=

# Object-store region.
AWS_DEFAULT_REGION=us-east-1

# Set issuer, audience and JWKS URL together for verified JWTs.
AGENT_OIDC_ISSUER=

# Expected JWT audience.
AGENT_OIDC_AUDIENCE=

# Verified signing-key endpoint.
AGENT_OIDC_JWKS_URL=

# Allowed JWT algorithms.
AGENT_OIDC_ALGORITHMS=RS256

# Tenant claim name.
AGENT_OIDC_TENANT_CLAIM=tenant_id

# Role claim name.
AGENT_OIDC_ROLES_CLAIM=roles

# Named signed hooks with distinct secrets and tenant bindings.
AGENT_WEBHOOKS_JSON='{}'

# Requires telemetry extra, telemetry feature permission and OTLP endpoint.
AGENT_TELEMETRY_ENABLED=0

# OTLP HTTP endpoint.
OTEL_EXPORTER_OTLP_ENDPOINT=

# Telemetry service name.
OTEL_SERVICE_NAME=agentic-system

# Optional OpenTelemetry SDK sampler.
OTEL_TRACES_SAMPLER=parentbased_always_on

# Worker logging level.
LOG_LEVEL=INFO

# Process mode; generated credentials are required in production.
RAGS_ENV=production

# Client token generated by bootstrap; production authentication uses the map.
RAGS_API_KEY=

# Token-to-tenant map. Bootstrap generates a distinct RAG token.
RAGS_KEYS_JSON='{}'

# PostgreSQL DSN generated for the non-superuser rags_app role.
RAGS_DATABASE_URL=

# Explicit SQLite compatibility path for standalone Python; Compose requires the PostgreSQL DSN.
RAGS_DB_PATH=/app/data/rags.db

# JSON boolean overrides; mounted from data/config.
RAGS_FEATURES_FILE=/app/config/rags.features.json

# Per-key overrides take precedence over the feature file.
RAGS_FEATURES_JSON='{}'

# local, openai, ollama, fastembed, sentence_transformers. local is deterministic hashing.
RAGS_EMBEDDING_PROVIDER=local

# extractive, openai, anthropic. Flags do not install or configure providers.
RAGS_MODEL_PROVIDER=extractive

# Optional dedicated OpenAI-compatible embedding endpoint; otherwise legacy OPENAI_BASE_URL.
RAGS_EMBEDDING_BASE_URL=

# Dedicated embedding credential; choose this or its _FILE, never both.
RAGS_EMBEDDING_API_KEY=

# Container-readable secret path, e.g. /app/config/embedding.key.
RAGS_EMBEDDING_API_KEY_FILE=

# Dedicated embedding model; otherwise OPENAI_EMBEDDING_MODEL.
RAGS_EMBEDDING_MODEL=
# Version the embedding space whenever an endpoint's vectors change.
RAGS_EMBEDDING_SPACE_ID=

# Explicit model revision and optional output dimensions; both affect index identity.
RAGS_EMBEDDING_REVISION=
RAGS_EMBEDDING_DIMENSIONS=

# Model-specific asymmetric retrieval prefixes and approved gateway input types.
RAGS_EMBEDDING_QUERY_PREFIX=
RAGS_EMBEDDING_DOCUMENT_PREFIX=
RAGS_EMBEDDING_QUERY_INPUT_TYPE=
RAGS_EMBEDDING_DOCUMENT_INPUT_TYPE=

# required, or explicit none for literal-loopback local services only.
RAGS_EMBEDDING_AUTH_MODE=required

# Custom model windows require BOTH the tokenizer JSON and token limit.
RAGS_EMBEDDING_TOKENIZER_JSON=
RAGS_EMBEDDING_MAX_TOKENS=

# Dedicated generation endpoint; otherwise the selected provider's legacy endpoint.
RAGS_GENERATION_BASE_URL=

# Dedicated generation credential; choose this or its _FILE, never both.
RAGS_GENERATION_API_KEY=

# Container-readable generation secret path.
RAGS_GENERATION_API_KEY_FILE=

# Dedicated generation model; otherwise selected provider's legacy model.
RAGS_GENERATION_MODEL=

# auto, openai or tinker protocol; Inkling auto selects Tinker output parameter.
RAGS_GENERATION_PROTOCOL=auto
# none is an explicit loopback-only local choice; remote/container service endpoints require auth.
RAGS_GENERATION_AUTH_MODE=required

# Empty preserves provider default; Inkling accepts named or numeric reasoning effort.
RAGS_REASONING_EFFORT=

# Per-alias RAG router protocol/reasoning capability overrides.
RAGS_ROUTER_MODEL_OPTIONS_JSON='{}'
# Matches the separate RAG router's local authentication boundary.
RAGS_ROUTER_AUTH_MODE=required
RAGS_ROUTER_ENABLED=true
RAGS_ROUTER_GATEWAY_URL=
RAGS_ROUTER_API_KEY=
RAGS_ROUTER_API_KEY_FILE=
RAGS_ROUTER_CA_FILE=
RAGS_ROUTER_MODELS_JSON='{}'
RAGS_ROUTER_ALLOW_HTTP=false
RAGS_ROUTER_MAX_OUTPUT_TOKENS=1024
RAGS_AGENT_ENABLED=true
RAGS_AGENT_MAX_STEPS=6
RAGS_AGENT_MAX_TOOL_CALLS=12
RAGS_AGENT_MAX_RUNTIME_SECONDS=60
RAGS_AGENT_MAX_HISTORY_TURNS=12
RAGS_MEMORY_ENABLED=true
RAGS_MEMORY_TTL_DAYS=30

# Empty uses the built-in unicode counter; exact option: {"backend":"tiktoken","encoding":"cl100k_base"}.
RAGS_TOKENIZER_JSON=

# Empty preserves provider-specific defaults; OpenAI generation uses its model tokenizer.
RAGS_GENERATION_TOKENIZER_JSON=

# Empty uses structure/max_tokens=850/overlap_tokens=120; JSON overrides are validated.
RAGS_CHUNKING_JSON=

# Total generation context units.
RAGS_CONTEXT_BUDGET=16000

# Output reserve inside context budget.
RAGS_OUTPUT_BUDGET=1024

# Message envelope reserve inside context budget.
RAGS_ENVELOPE_BUDGET=256

# Bounded retrieval iterations, 1..3.
RAGS_MAX_ITERATIONS=3

# Named federation sources with operator URLs and tenant_keys maps.
RAGS_SOURCES_JSON='{}'

# Requires the encoders extra and the selected trained model.
RAGS_FASTEMBED_MODEL=BAAI/bge-small-en-v1.5

# Persistent local model cache.
RAGS_MODEL_CACHE=/app/data/models

# Requires encoders and its actual model.
RAGS_LATE_INTERACTION_MODEL=answerdotai/answerai-colbert-small-v1

# Requires encoders and aligned image/text model artifacts.
RAGS_MULTIMODAL_MODEL=clip-vit-b-32

# calibrated_required needs a reviewed matching profile and runtime.
RAGS_ADMISSION_POLICY=compatibility

# Container path to an operator-selected profile; no profile enabled by default.
RAGS_ADMISSION_PROFILE=

# Named real upstream sidecars with tenant_tokens and timeouts; see README.
RAGS_RESEARCH_BACKENDS_JSON='{}'

# Legacy shared provider key; dedicated RAG keys take precedence.
OPENAI_API_KEY=

# Legacy shared key file; choose a value or file.
OPENAI_API_KEY_FILE=

# Legacy OpenAI-compatible base URL.
OPENAI_BASE_URL=https://api.openai.com/v1

# Legacy embedding model.
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# Legacy OpenAI chat model.
OPENAI_CHAT_MODEL=gpt-4.1-mini

# Legacy Anthropic key.
ANTHROPIC_API_KEY=

# Legacy Anthropic key file.
ANTHROPIC_API_KEY_FILE=

# Legacy Anthropic endpoint.
ANTHROPIC_BASE_URL=https://api.anthropic.com/v1

# Legacy Anthropic model.
ANTHROPIC_CHAT_MODEL=claude-sonnet-4-5

# Research sidecar settings are loaded in the separately installed sidecar process:
# RAGS_RESEARCH_ENGINE=lightrag
# Replace this placeholder with a separate token generated using secrets.token_urlsafe(32).
# RAGS_RESEARCH_KEYS_JSON={"REPLACE_WITH_GENERATED_SIDECAR_TOKEN":"local"}
# RAGS_RESEARCH_TIMEOUT_SECONDS=120
# RAGS_RESEARCH_CONCURRENCY=1
# RAGS_RESEARCH_WORK_DIR=/absolute/private/work-directory
# RAGS_RAPTOR_SOURCE=/absolute/path/to/pinned/raptor
# CLI/MCP clients use RAGS_URL and RAGS_API_KEY; source data/client.env after bootstrap.

# Custom route api_key_env names need explicit API/worker environment entries.
# See README for a compose override; .env alone does not forward arbitrary names.
