AGENT_ENV=development
AGENT_API_KEY=local-agent-key
AGENT_DB_PATH=./data/agentic.db
AGENT_RAG_URL=http://127.0.0.1:8000
AGENT_RAG_TIMEOUT_SECONDS=180
# Only for single-tenant local demo:
AGENT_RAG_API_KEY=local-development-key
# For multiple tenants and in production:
# AGENT_RAG_KEYS_JSON={"tenant-a":"unique-rag-token-a","tenant-b":"unique-rag-token-b"}
AGENT_MODEL_PROVIDER=offline
AGENT_RAG_ADMISSION_POLICY=compatibility
# Required mode needs reviewed RAG profiles and the same controls in API/worker.
# AGENT_RAG_ADMISSION_POLICY=calibrated_required
# AGENT_RAG_ADMISSION_PROFILE_IDS_JSON=["replace-with-frozen-profile-id"]
AGENT_MAX_PARALLEL=4
# Local Compose optional RAG model switches:
RAGS_API_KEY=local-development-key
RAGS_EMBEDDING_PROVIDER=local
RAGS_MODEL_PROVIDER=extractive
# Set RAGS_EMBEDDING_PROVIDER=openai for trained semantic embeddings.
# Set RAGS_MODEL_PROVIDER=openai or anthropic for generated answers.
# AGENT_KEYS_JSON={"strong-production-token":"tenant-id"}
# AGENT_MODEL_PROVIDER=openai
# OPENAI_API_KEY=
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_CHAT_MODEL=gpt-4.1-mini
# AGENT_MODEL_PROVIDER=anthropic
# ANTHROPIC_API_KEY=
# ANTHROPIC_CHAT_MODEL=claude-sonnet-4-5
# v0.2 optional controls; load into API and worker environments consistently.
# AGENT_APPROVER_KEYS_JSON={"separate-approval-credential":"local"}
# AGENT_LEASE_SECONDS=180
# AGENT_HEARTBEAT_SECONDS=30
# AGENT_STEP_TIMEOUT_SECONDS=300
# AGENT_MAX_ATTEMPTS=3
# AGENT_MAX_MODEL_TOKENS=12000
# AGENT_MAX_MODEL_OUTPUT_TOKENS=1000
# AGENT_MAX_QUEUED_RUNS=100
# AGENT_RATE_PER_MINUTE=600
# AGENT_ARTIFACT_DIR=./data/artifacts
# AGENT_TENANT_POLICIES_JSON={"local":{"allowed_namespaces":["default","notes"]}}

# Verified JWT authentication; all three values are required together.
# AGENT_OIDC_ISSUER=https://identity.example
# AGENT_OIDC_AUDIENCE=agentic-system
# AGENT_OIDC_JWKS_URL=https://identity.example/.well-known/jwks.json
# AGENT_OIDC_ALGORITHMS=RS256
# AGENT_WEBHOOKS_JSON={"source":{"tenant":"local","secret":"replace-with-at-least-24-characters"}}

# Optional real shared services: install .[postgres,storage,telemetry].
# AGENT_DATABASE_URL=postgresql://user:password@localhost:5432/agentic
# AGENT_REDIS_URL=redis://localhost:6379/0
# AGENT_ARTIFACT_BACKEND=s3
# AGENT_S3_BUCKET=agent-artifacts
# AGENT_S3_ENDPOINT=https://object-store.example
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_DEFAULT_REGION=us-east-1
# AGENT_TELEMETRY_ENABLED=1
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
# OTEL_SERVICE_NAME=agentic-system
# OTEL_TRACES_SAMPLER=parentbased_always_on

# Add current input_cost_per_million/output_cost_per_million before using a dollar budget.
# Missing usage remains explicitly estimated; prices are never guessed.
# AGENT_MODEL_ROUTES_JSON=[{"name":"primary","provider":"openai","model":"gpt-4.1-mini","api_key_env":"OPENAI_API_KEY","purposes":["planning","synthesis"]}]
